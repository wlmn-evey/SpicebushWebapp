---
import {
  Home,
  Clock,
  DollarSign,
  Users,
  Settings,
  Image as ImageIcon,
  CircleHelp,
  MessageSquare,
  Mail,
  LineChart,
  Tent,
  Bell,
  HandHeart,
  Newspaper
} from 'lucide-astro';

export interface Props {
  userEmail?: string;
}

const { userEmail = 'Administrator' } = Astro.props;
const currentPath = Astro.url.pathname;
const userInitial = userEmail.charAt(0).toUpperCase();
const displayName = userEmail.includes('@') ? userEmail.split('@')[0] : userEmail;
---

<!-- Admin Navigation Sidebar Component -->
<nav
  class="bg-white border-r border-gray-200 w-64 h-full fixed left-0 top-0 z-40 transform -translate-x-full lg:translate-x-0 transition-transform"
  id="admin-sidebar"
>
  <div class="flex flex-col h-full">
    <!-- Header -->
    <div class="p-6 border-b border-gray-200">
      <div class="flex items-center">
        <img src="/SpicebushLogo-03.png" alt="Spicebush Montessori" class="h-10 w-auto mr-3" />
        <div>
          <h2 class="text-lg font-semibold text-earth-brown">Admin Panel</h2>
          <p class="text-sm text-gray-600">Management Center</p>
        </div>
      </div>
    </div>

    <!-- Navigation Links -->
    <div class="flex-1 overflow-y-auto py-4">
      <div class="px-3 space-y-0.5">
        <a
          href="/admin"
          aria-current={currentPath === '/admin' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Home className="w-5 h-5 mr-3" />
          Dashboard
        </a>

        <!-- Content -->
        <p class="admin-nav-group-label">Content</p>
        <a
          href="/admin/hours"
          aria-current={currentPath === '/admin/hours' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Clock className="w-5 h-5 mr-3" />
          School Hours
        </a>
        <a
          href="/admin/staff"
          aria-current={currentPath === '/admin/staff' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Users className="w-5 h-5 mr-3" />
          Staff
        </a>
        <a
          href="/admin/testimonials"
          aria-current={currentPath === '/admin/testimonials' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <MessageSquare className="w-5 h-5 mr-3" />
          Testimonials
        </a>
        <a
          href="/admin/faq"
          aria-current={currentPath === '/admin/faq' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <CircleHelp className="w-5 h-5 mr-3" />
          FAQs
        </a>
        <a
          href="/admin/media"
          aria-current={currentPath === '/admin/media' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <ImageIcon className="w-5 h-5 mr-3" />
          Media
        </a>
        <a
          href="/admin/blog"
          aria-current={currentPath === '/admin/blog' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Newspaper className="w-5 h-5 mr-3" />
          Blog
        </a>

        <!-- Programs -->
        <p class="admin-nav-group-label">Programs</p>
        <a
          href="/admin/tuition"
          aria-current={currentPath === '/admin/tuition' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <DollarSign className="w-5 h-5 mr-3" />
          Tuition & Programs
        </a>
        <a
          href="/admin/camp"
          aria-current={currentPath === '/admin/camp' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Tent className="w-5 h-5 mr-3" />
          Camp
        </a>

        <!-- Communications -->
        <p class="admin-nav-group-label">Communications</p>
        <a
          href="/admin/announcements"
          aria-current={currentPath === '/admin/announcements' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Bell className="w-5 h-5 mr-3" />
          Announcements
        </a>
        <a
          href="/admin/contact-submissions"
          aria-current={currentPath === '/admin/contact-submissions' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Mail className="w-5 h-5 mr-3" />
          Contact Submissions
        </a>
        <a
          href="/admin/donations"
          aria-current={currentPath === '/admin/donations' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <HandHeart className="w-5 h-5 mr-3" />
          Donations
        </a>

        <!-- System -->
        <p class="admin-nav-group-label">System</p>
        <a
          href="/admin/seo"
          aria-current={currentPath === '/admin/seo' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <LineChart className="w-5 h-5 mr-3" />
          SEO & Analytics
        </a>
        <a
          href="/admin/settings"
          aria-current={currentPath === '/admin/settings' ? 'page' : undefined}
          class="admin-nav-link group flex items-center px-3 py-2 text-sm font-medium rounded-lg"
        >
          <Settings className="w-5 h-5 mr-3" />
          System Settings
        </a>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-6 border-t border-gray-200">
      <div class="flex items-center">
        <div class="w-8 h-8 bg-forest-canopy rounded-full flex items-center justify-center">
          <span class="text-white text-sm font-medium">{userInitial}</span>
        </div>
        <div class="ml-3 min-w-0">
          <p class="text-sm font-medium text-earth-brown truncate">{displayName}</p>
          <p class="text-xs text-gray-600">Administrator</p>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile hamburger button -->
<button
  type="button"
  id="admin-sidebar-toggle"
  class="fixed top-4 left-4 z-50 inline-flex items-center justify-center rounded-lg border border-gray-200 bg-white p-2 shadow-md lg:hidden"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="admin-sidebar"
>
  <svg
    id="admin-menu-icon"
    class="h-6 w-6 text-earth-brown"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
  <svg
    id="admin-close-icon"
    class="hidden h-6 w-6 text-earth-brown"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
  </svg>
</button>

<!-- Mobile Overlay -->
<div class="fixed inset-0 bg-gray-600/75 z-30 lg:hidden hidden" id="admin-sidebar-overlay"></div>

<script>
  function initAdminSidebar() {
    const toggle = document.getElementById('admin-sidebar-toggle');
    const sidebar = document.getElementById('admin-sidebar');
    const overlay = document.getElementById('admin-sidebar-overlay');
    const menuIcon = document.getElementById('admin-menu-icon');
    const closeIcon = document.getElementById('admin-close-icon');

    if (!toggle || !sidebar || !overlay || !menuIcon || !closeIcon) return;

    // Re-bind to const locals so TypeScript narrows them as non-null inside closures
    const _toggle = toggle;
    const _sidebar = sidebar;
    const _overlay = overlay;
    const _menuIcon = menuIcon;
    const _closeIcon = closeIcon;

    function openSidebar() {
      _sidebar.classList.remove('-translate-x-full');
      _sidebar.classList.add('translate-x-0');
      _overlay.classList.remove('hidden');
      _toggle.setAttribute('aria-expanded', 'true');
      _menuIcon.classList.add('hidden');
      _closeIcon.classList.remove('hidden');
    }

    function closeSidebar() {
      _sidebar.classList.add('-translate-x-full');
      _sidebar.classList.remove('translate-x-0');
      _overlay.classList.add('hidden');
      _toggle.setAttribute('aria-expanded', 'false');
      _menuIcon.classList.remove('hidden');
      _closeIcon.classList.add('hidden');
    }

    _toggle.addEventListener('click', () => {
      const isOpen = _toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    _overlay.addEventListener('click', closeSidebar);

    // Close sidebar when a nav link is clicked (mobile)
    _sidebar.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 1024) {
          closeSidebar();
        }
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && _toggle.getAttribute('aria-expanded') === 'true') {
        closeSidebar();
      }
    });
  }

  initAdminSidebar();
  document.addEventListener('astro:page-load', initAdminSidebar);
</script>

<style>
  .admin-nav-link {
    @apply text-gray-700 hover:bg-gray-100 hover:text-forest-canopy transition-colors;
  }

  .admin-nav-link[aria-current='page'] {
    @apply bg-forest-canopy text-white;
  }

  .admin-nav-group-label {
    @apply px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wider text-gray-400;
  }
</style>
