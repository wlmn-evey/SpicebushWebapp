---
import '../styles/global.css';
import AdminNav from '@components/AdminNav.astro';
import ExternalLinkTargetBehavior from '@components/ExternalLinkTargetBehavior.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const locals = Astro.locals as unknown as Record<string, unknown>;
const userEmail = typeof locals.userEmail === 'string' ? locals.userEmail : 'Administrator';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-beige min-h-screen text-earth-brown">
    <AdminNav userEmail={userEmail} />

    <main class="lg:ml-64 min-h-screen">
      <header
        class="border-b border-gray-200 bg-white/80 backdrop-blur px-6 py-5 pl-16 lg:pl-6 sticky top-0 z-20"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h1 class="text-2xl font-heading font-bold tracking-tight">{title}</h1>
          <div class="text-sm text-earth-brown/80">
            Signed in as <span class="font-semibold">{userEmail}</span>
          </div>
        </div>
      </header>
      <section class="p-6">
        <slot />
      </section>
    </main>
    <ExternalLinkTargetBehavior />

    <!-- Shared admin scripts: auto-dismiss alerts, submit loading, delete confirm -->
    <script>
      function initAdminScripts() {
        // Auto-dismiss success messages after 6 seconds
        // Use data-admin-alert attribute to target only flash-message alerts
        document.querySelectorAll('[data-admin-alert]').forEach(el => {
          const alert = el as HTMLElement;
          setTimeout(() => {
            alert.style.transition =
              'opacity 0.4s ease, max-height 0.4s ease, margin 0.4s ease, padding 0.4s ease';
            alert.style.opacity = '0';
            alert.style.maxHeight = '0';
            alert.style.marginBottom = '0';
            alert.style.paddingTop = '0';
            alert.style.paddingBottom = '0';
            alert.style.overflow = 'hidden';
          }, 6000);
        });

        // Delete confirmation fires FIRST — before loading state
        document.querySelectorAll('form[data-confirm]').forEach(form => {
          form.addEventListener('submit', e => {
            const message = (form as HTMLFormElement).dataset.confirm ?? 'Are you sure?';
            if (!window.confirm(message)) {
              e.preventDefault();
              e.stopImmediatePropagation();
            }
          });
        });

        // Submit button loading state — prevent double-submit. Deferred one macrotask so it runs
        // AFTER every other submit listener (whatever the registration order) and can see whether
        // one of them cancelled the submit — a page-level guard (e.g. the blog editor's
        // "Body is required to publish") must not leave a dead, "Saving…" button behind (#132).
        document.querySelectorAll('form').forEach(form => {
          form.addEventListener('submit', event => {
            setTimeout(() => {
              if (event.defaultPrevented) return;
              // Disable EVERY submit button in the form (e.g. the blog editor has one in the action
              // bar and one under the sidebar) — disabling only the first left the other live for a
              // double-submit. The loading label goes on the button that was pressed (or the first,
              // for an Enter-key submit).
              const buttons = Array.from(
                form.querySelectorAll<HTMLButtonElement>('button[type="submit"]')
              ).filter(btn => btn.dataset.noLoading !== 'true');
              const pressed = (event as SubmitEvent).submitter;
              const labelled =
                buttons.find(btn => btn === pressed) ?? (pressed ? undefined : buttons[0]);
              buttons.forEach(btn => {
                btn.disabled = true;
                btn.classList.add('opacity-70', 'cursor-not-allowed');
              });
              if (labelled) {
                labelled.dataset.originalText = labelled.textContent?.trim() ?? '';
                labelled.textContent =
                  labelled.dataset.loadingText ??
                  (labelled.dataset.originalText.toLowerCase().startsWith('delete')
                    ? 'Deleting\u2026'
                    : 'Saving\u2026');
              }
            }, 0);
          });
        });
      }

      initAdminScripts();
      document.addEventListener('astro:page-load', initAdminScripts);
    </script>
  </body>
</html>
