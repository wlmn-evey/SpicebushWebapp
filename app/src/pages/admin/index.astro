---
import AdminLayout from '@layouts/AdminLayout.astro';
import { db } from '@lib/db';
import { evaluateCampMode, parseCampModeSettings } from '@lib/camp-mode';
import { logServerError } from '@lib/server-logger';
import { Mail, Bell, Tent, CalendarX, ArrowRight } from 'lucide-astro';

/* ── Fetch dashboard data in parallel ── */
let contactCount = 0;
let activeAnnouncements: { title: string; severity: string }[] = [];
let upcomingClosures: { title: string; startDate: string; endDate: string }[] = [];
let campPromo: { openWeeks: number; limitedWeeks: number; totalPublishedWeeks: number } | null =
  null;
let campModeLabel = 'Off';

try {
  const [contactResult, announcementData, allSettings, promoSummary] = await Promise.all([
    db.contact.getContactSubmissions({ page: 1, pageSize: 1 }),
    db.announcements.getAnnouncementAdminData(),
    db.content.getAllSettings(),
    db.camp.getCampPromotionSummary()
  ]);

  contactCount = contactResult.total;

  activeAnnouncements = announcementData.announcements
    .filter(a => a.isPublished)
    .slice(0, 5)
    .map(a => ({ title: a.title, severity: a.severity }));

  const now = new Date();
  const sevenDaysOut = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);
  const nowStr = now.toISOString().slice(0, 10);
  const futureStr = sevenDaysOut.toISOString().slice(0, 10);
  upcomingClosures = announcementData.scheduleExceptions
    .filter(e => e.isPublished && e.endDate >= nowStr && e.startDate <= futureStr)
    .slice(0, 3)
    .map(e => ({ title: e.title, startDate: e.startDate, endDate: e.endDate }));

  const campMode = evaluateCampMode(parseCampModeSettings(allSettings));
  campModeLabel = campMode.active ? 'Live' : campMode.prepMode ? 'Prep' : 'Off';

  if (promoSummary.available) {
    campPromo = {
      openWeeks: promoSummary.openWeeks,
      limitedWeeks: promoSummary.limitedWeeks,
      totalPublishedWeeks: promoSummary.totalPublishedWeeks
    };
  }
} catch (error) {
  logServerError('Failed to load dashboard data', error, { component: 'AdminDashboard' });
}

const severityColor = (severity: string): string => {
  if (severity === 'urgent' || severity === 'closure') return 'bg-red-100 text-red-800';
  if (severity === 'reminder') return 'bg-amber-100 text-amber-800';
  return 'bg-blue-100 text-blue-800';
};

const campStatusColor =
  campModeLabel === 'Live'
    ? 'text-green-700 bg-green-50 border-green-200'
    : campModeLabel === 'Prep'
      ? 'text-purple-700 bg-purple-50 border-purple-200'
      : 'text-gray-700 bg-gray-50 border-gray-200';
---

<AdminLayout title="Admin Dashboard">
  <!-- Live stats row -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <a
      href="/admin/contact-submissions"
      class="group flex items-start gap-3 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md"
    >
      <div class="rounded-lg bg-blue-50 p-2.5 text-blue-600">
        <Mail className="h-5 w-5" />
      </div>
      <div>
        <p class="text-2xl font-bold text-earth-brown">{contactCount}</p>
        <p class="text-sm text-earth-brown/70">Contact submissions</p>
      </div>
    </a>

    <a
      href="/admin/announcements"
      class="group flex items-start gap-3 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md"
    >
      <div class="rounded-lg bg-amber-50 p-2.5 text-amber-600">
        <Bell className="h-5 w-5" />
      </div>
      <div>
        <p class="text-2xl font-bold text-earth-brown">{activeAnnouncements.length}</p>
        <p class="text-sm text-earth-brown/70">Active announcements</p>
      </div>
    </a>

    <a
      href="/admin/camp"
      class="group flex items-start gap-3 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md"
    >
      <div class="rounded-lg bg-green-50 p-2.5 text-green-600">
        <Tent className="h-5 w-5" />
      </div>
      <div>
        <span
          class={`inline-block rounded-full border px-2 py-0.5 text-xs font-semibold ${campStatusColor}`}
        >
          Camp {campModeLabel}
        </span>
        {
          campPromo && campPromo.totalPublishedWeeks > 0 ? (
            <p class="mt-1 text-sm text-earth-brown/70">
              {campPromo.openWeeks} open, {campPromo.limitedWeeks} limited
            </p>
          ) : (
            <p class="mt-1 text-sm text-earth-brown/70">No published weeks</p>
          )
        }
      </div>
    </a>

    <div class="flex items-start gap-3 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="rounded-lg bg-red-50 p-2.5 text-red-600">
        <CalendarX className="h-5 w-5" />
      </div>
      <div>
        <p class="text-2xl font-bold text-earth-brown">{upcomingClosures.length}</p>
        <p class="text-sm text-earth-brown/70">Closures next 7 days</p>
      </div>
    </div>
  </div>

  <!-- Active announcements feed -->
  {
    activeAnnouncements.length > 0 && (
      <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-semibold text-earth-brown">Active Announcements</h2>
          <a
            href="/admin/announcements"
            class="text-sm font-medium text-forest-canopy hover:underline"
          >
            Manage
          </a>
        </div>
        <ul class="mt-3 space-y-2">
          {activeAnnouncements.map(a => (
            <li class="flex items-center gap-2 text-sm">
              <span
                class={`rounded-full px-2 py-0.5 text-xs font-semibold ${severityColor(a.severity)}`}
              >
                {a.severity}
              </span>
              <span class="text-earth-brown">{a.title}</span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Upcoming closures feed -->
  {
    upcomingClosures.length > 0 && (
      <div class="mt-4 rounded-2xl border border-amber-200 bg-amber-50/50 p-5 shadow-sm">
        <h2 class="text-lg font-semibold text-earth-brown">Upcoming Closures</h2>
        <ul class="mt-3 space-y-2">
          {upcomingClosures.map(c => (
            <li class="flex items-center gap-2 text-sm">
              <CalendarX className="h-4 w-4 text-amber-600" />
              <span class="font-medium text-earth-brown">{c.title}</span>
              <span class="text-earth-brown/60">
                {c.startDate === c.endDate ? c.startDate : `${c.startDate} \u2013 ${c.endDate}`}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <!-- Navigation grid -->
  <h2 class="mt-8 mb-4 text-lg font-semibold text-earth-brown">Quick Access</h2>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      [
        {
          href: '/admin/hours',
          title: 'Hours',
          desc: 'Edit school hours displayed in widgets and public pages.'
        },
        {
          href: '/admin/staff',
          title: 'Staff',
          desc: 'Manage teacher and staff bios shown across the site.'
        },
        {
          href: '/admin/tuition',
          title: 'Tuition',
          desc: 'Update tuition programs and rate tiers for the calculator.'
        },
        {
          href: '/admin/testimonials',
          title: 'Testimonials',
          desc: 'Control quotes, ratings, and visibility rules.'
        },
        {
          href: '/admin/contact-submissions',
          title: 'Contact Submissions',
          desc: 'Review inquiries from the contact form.'
        },
        {
          href: '/admin/announcements',
          title: 'Announcements',
          desc: 'Publish updates, reminders, and closure notices.'
        },
        {
          href: '/admin/camp',
          title: 'Camp',
          desc: 'Manage camp seasons, weeks, and registration.'
        },
        {
          href: '/admin/donations',
          title: 'Donations',
          desc: 'Manage donor thank-you templates and delivery status.'
        },
        {
          href: '/admin/seo',
          title: 'SEO & Analytics',
          desc: 'Monitor traffic, campaigns, and conversions.'
        },
        {
          href: '/admin/settings',
          title: 'Settings',
          desc: 'Control coming-soon mode and site configuration.'
        },
        { href: '/admin/media', title: 'Media', desc: 'Adjust image focal points and crop zones.' },
        { href: '/admin/faq', title: 'FAQs', desc: 'Manage Q&A sections shown on the FAQ page.' }
      ].map(card => (
        <a
          href={card.href}
          class="group flex items-start justify-between rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:shadow-md"
        >
          <div>
            <h3 class="text-base font-semibold text-earth-brown">{card.title}</h3>
            <p class="mt-1 text-sm text-earth-brown/70">{card.desc}</p>
          </div>
          <ArrowRight className="mt-0.5 h-4 w-4 shrink-0 text-gray-400 transition group-hover:text-forest-canopy" />
        </a>
      ))
    }
  </div>
</AdminLayout>
