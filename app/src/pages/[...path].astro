---
// Catch-all for any path that no other route matches (typos, old URLs, stray
// asset/module requests). It used to 302 everything to the homepage, which
// search engines treat as a soft 404. Return a real 404 instead: an empty-body
// 404 Response makes Astro render the branded src/pages/404.astro (same pattern
// as blog/[slug].astro).
//
// Known legacy URLs that should permanently move go here as explicit 301s, e.g.
//   if (path === 'old-page') return Astro.redirect('/new-page', 301);
// (none are currently known; legacy blog URLs are handled in blog/[slug].astro).
export const prerender = false;

return new Response(null, { status: 404 });
---
