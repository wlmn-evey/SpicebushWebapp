---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactInfo from '../components/ContactInfo.astro';
import { db } from '@lib/db';
import { logServerError } from '@lib/server-logger';
import { FileText, Mail, Phone, ExternalLink } from 'lucide-astro';

const LAST_UPDATED = 'November 25, 2026';

let email = 'information@spicebushmontessori.org';
let phone = '(484) 202-0712';

try {
  const [dbEmail, dbPhone] = await Promise.all([
    db.content.getSetting('school_email').catch(() => null),
    db.content.getSetting('school_phone').catch(() => null)
  ]);

  if (typeof dbEmail === 'string' && dbEmail.trim().length > 0) {
    email = dbEmail.trim();
  }
  if (typeof dbPhone === 'string' && dbPhone.trim().length > 0) {
    phone = dbPhone.trim();
  }
} catch (error) {
  logServerError('Failed to load contact settings on privacy policy page', error, {
    route: '/privacy-policy'
  });
}

const phoneDigits = phone.replace(/[^0-9]/g, '');
---

<Layout
  title="Privacy Policy - Spicebush Montessori School"
  description="How Spicebush Montessori School collects, uses, stores, and protects personal information on our website, including children's privacy, cookies, analytics, donations, and your choices."
  keywords="privacy policy, data protection, children's privacy, COPPA, website privacy, Spicebush Montessori"
>
  <Header />

  <main id="main-content">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-forest-canopy to-moss-green py-16 lg:py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <div class="flex justify-center mb-6">
            <div
              class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-2xl flex items-center justify-center border border-white/30"
            >
              <FileText className="w-8 h-8 text-white" aria-hidden="true" />
            </div>
          </div>
          <h1 class="text-4xl lg:text-5xl font-heading font-bold text-white mb-4 tracking-tight">
            Privacy Policy
          </h1>
          <p
            class="text-lg lg:text-xl text-green-100 max-w-3xl mx-auto leading-relaxed-plus font-light"
          >
            How Spicebush Montessori School collects, uses, and protects your family&apos;s personal
            information when you visit our website or contact our school.
          </p>
          <p class="mt-4 text-sm text-green-100/90">Last updated: {LAST_UPDATED}</p>
        </div>
      </div>
    </section>

    <!-- Policy Body -->
    <section class="py-12 lg:py-16 bg-stone-beige">
      <div class="container mx-auto px-4 max-w-4xl">
        <div
          class="bg-warm-white rounded-2xl p-8 lg:p-12 shadow-sm border border-gray-200 space-y-10"
        >
          <!-- Overview -->
          <section aria-labelledby="privacy-overview">
            <h2 id="privacy-overview" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              1. Who We Are &amp; Scope
            </h2>
            <p class="text-earth-brown leading-relaxed-plus mb-4">
              Spicebush Montessori School (&ldquo;Spicebush,&rdquo; &ldquo;we,&rdquo;
              &ldquo;our,&rdquo; or &ldquo;us&rdquo;) is a nonprofit Montessori early childhood
              school located in Glen Mills, Pennsylvania. We respect the privacy of every family,
              caregiver, donor, and visitor who interacts with{' '}
              <a
                href="https://spicebushmontessori.org"
                class="text-forest-canopy underline hover:text-moss-green"
                >spicebushmontessori.org</a
              >.
            </p>
            <p class="text-earth-brown leading-relaxed-plus">
              This Privacy Policy explains what information we collect through our website, why we
              collect it, which service providers help us operate the site, and how you can access,
              correct, or request deletion of your information. This policy applies only to
              information collected through our website and does not govern offline student
              education records, which are handled separately through our enrollment and Family
              Handbook procedures.
            </p>
          </section>

          <!-- Information Collected -->
          <section aria-labelledby="privacy-collected">
            <h2 id="privacy-collected" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              2. Information We Collect
            </h2>

            <h3 class="text-xl font-semibold text-earth-brown mt-6 mb-3">
              Information You Provide Directly
            </h3>
            <ul class="list-disc pl-6 space-y-2 text-earth-brown leading-relaxed-plus">
              <li>
                <strong>Contact, Tour, Camp &amp; Admissions Inquiries:</strong> Depending on the form
                you submit, we collect your name, email address, phone number, subject, message, tour
                preference, program interest, referral source, and your child&apos;s age or birthdate
                (required on certain tour or enrollment-interest forms so we can confirm program age eligibility).
              </li>
              <li>
                <strong>Online Donations:</strong> When you initiate a one-time or recurring monthly donation
                on our Donate page, you choose an amount and frequency and are redirected to Stripe&apos;s
                secure hosted checkout. Stripe collects your payment card and billing information directly;
                Spicebush never receives or stores full payment card numbers. Stripe sends us confirmation
                records (such as donor name, email address, donation amount, frequency, transaction/subscription
                identifiers, and payment status) so we can record gifts and send thank-you messages.
              </li>
              <li>
                <strong>School Staff Accounts:</strong> Authorized school administrators sign in using
                school-approved email addresses (via magic-link email or Auth0). For security auditing,
                administrator login records log the staff member&apos;s IP address and browser user-agent.
              </li>
            </ul>

            <h3 class="text-xl font-semibold text-earth-brown mt-6 mb-3">
              Information Collected Automatically
            </h3>
            <ul class="list-disc pl-6 space-y-2 text-earth-brown leading-relaxed-plus">
              <li>
                <strong>First-Party Website Analytics (when enabled):</strong> To understand how prospective
                families discover our school and which pages are most helpful, our website records page
                views, button/link clicks, form submission events, browser user-agent strings, referring
                URLs, and campaign parameters (such as UTM tags or Google Ads click IDs <code
                  class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">gclid</code
                >, <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">gbraid</code>, and{
                  ' '
                }
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">wbraid</code>). Our
                analytics script stores a first-party cookie named{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sb_session_id</code>
                (which expires after 30 days) and browser{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">localStorage</code>{' '}
                entries (<code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded"
                  >sb_client_id</code
                >, <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sb_first_touch</code>,
                and <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sb_last_touch</code
                >). We do not store raw visitor IP addresses on analytics event rows (IP addresses
                are checked transiently in memory for rate limiting only).
              </li>
              <li>
                <strong>Linking Analytics to Form Submissions:</strong> When you submit a contact or inquiry
                form on our website, your browser&apos;s{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sb_session_id</code>,{
                  ' '
                }
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sb_client_id</code>,
                landing page, referrer URL, and campaign attribution parameters are submitted with
                and stored alongside your inquiry record so our team can understand which outreach
                channels bring families to Spicebush.
              </li>
              <li>
                <strong>Google Analytics 4 (when enabled):</strong> When Google Analytics 4 is active,
                Google uses cookies and identifiers (such as{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">_ga</code> and{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">_ga_*</code>) to measure
                aggregated site usage. Per Google&apos;s GA4 architecture, Google does not log or
                store full IP addresses after transient geolocation lookup. Learn more at{' '}
                <a
                  href="https://www.google.com/policies/privacy/partners/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-forest-canopy underline hover:text-moss-green inline-flex items-center gap-1"
                >
                  How Google uses information from sites or apps that use our services<ExternalLink
                    className="w-3.5 h-3.5"
                    aria-hidden="true"
                  /><span class="sr-only"> (opens in a new tab)</span>
                </a>.
              </li>
              <li>
                <strong>Form Security &amp; Anti-Spam Signals:</strong> When you submit a public inquiry
                form, we record the submitting IP address and submission timing metadata to enforce rate
                limits and block automated spam.
              </li>
              <li>
                <strong>Essential Administrative Cookies:</strong> Logged-in school administrators receive
                strictly necessary <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded"
                  >HttpOnly</code
                > authentication and preview cookies (<code
                  class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sbms-admin-session</code
                >, <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded"
                  >sbms-preview-mode</code
                >, and — when Auth0 sign-in is enabled — temporary OAuth cookies{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sbms-auth0-state</code>,{
                  ' '
                }
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sbms-auth0-nonce</code>,
                and <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">sbms-auth0-next</code
                >). These cookies are not set for general public visitors.
              </li>
            </ul>
          </section>

          <!-- Children's Privacy -->
          <section
            aria-labelledby="privacy-children"
            class="rounded-xl bg-stone-beige/70 border border-forest-canopy/20 p-6"
          >
            <h2 id="privacy-children" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              3. Children&apos;s Privacy (COPPA)
            </h2>
            <p class="text-earth-brown leading-relaxed-plus mb-3">
              Our website is designed for parents, guardians, caregivers, educators, and community
              supporters — it is <strong>not directed to children under 13</strong>. We do not
              knowingly collect personal information directly from children online.
            </p>
            <p class="text-earth-brown leading-relaxed-plus">
              Any child&apos;s age or birthdate entered on an admissions, tour, or contact form is
              provided by a parent or guardian solely to help our team answer program eligibility
              and enrollment questions. If you believe a child under 13 has submitted personal
              information through our website without parental consent, please contact us
              immediately at{' '}
              <a
                href={`mailto:${email}`}
                class="font-semibold text-forest-canopy underline hover:text-moss-green">{email}</a
              > and we will promptly delete it.
            </p>
          </section>

          <!-- How We Use Information -->
          <section aria-labelledby="privacy-use">
            <h2 id="privacy-use" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              4. How We Use Information
            </h2>
            <ul class="list-disc pl-6 space-y-2 text-earth-brown leading-relaxed-plus mb-4">
              <li>Respond to parent, caregiver, admissions, camp, and general inquiries.</li>
              <li>Coordinate school tours, open houses, and enrollment follow-up.</li>
              <li>Process, record, and acknowledge charitable donations.</li>
              <li>Send requested school announcements or updates to school families.</li>
              <li>
                Protect our website and forms against automated spam, abuse, and security threats.
              </li>
              <li>
                Measure website performance and understand how families find Spicebush Montessori.
              </li>
            </ul>
            <p class="text-earth-brown font-semibold leading-relaxed-plus">
              We never sell, rent, or trade your personal information or family contact details to
              third parties.
            </p>
          </section>

          <!-- Third-Party Services -->
          <section aria-labelledby="privacy-third-parties">
            <h2
              id="privacy-third-parties"
              class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4"
            >
              5. Service Providers &amp; External Platforms
            </h2>
            <p class="text-earth-brown leading-relaxed-plus mb-4">
              We share information only with trusted infrastructure and service providers strictly
              as needed to run our website and communicate with families, or when required by law:
            </p>
            <ul class="list-disc pl-6 space-y-2 text-earth-brown leading-relaxed-plus mb-4">
              <li>
                <strong>Netlify &amp; Neon (PostgreSQL):</strong> Website hosting, media storage (Netlify
                Blobs), and hosted PostgreSQL database infrastructure (with TLS encryption in transit
                and provider-managed encryption at rest).
              </li>
              <li>
                <strong>Stripe:</strong> Hosted payment processing for one-time and recurring monthly
                donations, governed by{' '}
                <a
                  href="https://stripe.com/privacy"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-forest-canopy underline hover:text-moss-green inline-flex items-center gap-1"
                >
                  Stripe&apos;s Privacy Policy<ExternalLink
                    className="w-3.5 h-3.5"
                    aria-hidden="true"
                  /><span class="sr-only"> (opens in a new tab)</span>
                </a>.
              </li>
              <li>
                <strong>Cloudflare Turnstile:</strong> Bot and spam verification on public inquiry forms,
                which evaluates browser and network signals and may set anti-bot tokens, governed by{
                  ' '
                }
                <a
                  href="https://www.cloudflare.com/privacypolicy/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-forest-canopy underline hover:text-moss-green inline-flex items-center gap-1"
                >
                  Cloudflare&apos;s Privacy Policy<ExternalLink
                    className="w-3.5 h-3.5"
                    aria-hidden="true"
                  /><span class="sr-only"> (opens in a new tab)</span>
                </a>.
              </li>
              <li>
                <strong>Email Delivery &amp; Admin Authentication Providers:</strong> SendGrid and/or
                UniOne for delivering inquiry confirmations, donation thank-you messages, and school announcements,
                and Auth0 when enabled for staff sign-in.
              </li>
              <li>
                <strong>Google Services (Analytics, Fonts, Maps, Forms):</strong> Optional Google Analytics
                4, Google Fonts web typography, the embedded location map on our Contact page, and our
                feedback form hosted on Google Forms (Spicebush does not ask for your name or email on
                that form, though Google collects standard technical data under Google&apos;s Privacy
                Policy).
              </li>
              <li>
                <strong>External School Tools &amp; Links:</strong> Links to Transparent Classroom (online
                admissions applications), Calendly (campus tour scheduling), PA DHS Child Care Works,
                American Montessori Society, and social media pages (Facebook, Instagram, X) direct you
                to external platforms governed by their own privacy policies.
              </li>
              <li>
                <strong>Public Holiday Data (Nager.Date):</strong> Pages displaying our school hours widget
                currently make a direct browser request to{' '}
                <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded">date.nager.at</code> to fetch
                public U.S. federal holiday dates, which transmits standard browser request metadata (such
                as IP address and user-agent) to that service.
              </li>
              <li>
                <strong>Internal Admin Content Tools (Optional):</strong> School administrators may optionally
                use AI-assisted tools (Google Gemini and/or OpenAI APIs) to help draft page metadata or
                suggest image crop framing for published school photography. No visitor form submissions
                or donor records are sent to these tools.
              </li>
            </ul>
            <p class="text-earth-brown leading-relaxed-plus">
              Once you follow a link to an external website or third-party platform, that
              provider&apos;s privacy policy governs your interaction.
            </p>
          </section>

          <!-- Retention & Security -->
          <section aria-labelledby="privacy-security">
            <h2 id="privacy-security" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              6. Data Security &amp; Retention
            </h2>
            <p class="text-earth-brown leading-relaxed-plus mb-4">
              We use reasonable administrative and technical safeguards — including HTTPS/TLS
              encryption in transit, provider-managed encryption at rest on our hosted database,
              restricted administrator authentication, and never storing payment card numbers — to
              protect the information you share with us. No method of internet transmission or
              electronic storage is 100% secure, so please avoid sending sensitive medical,
              financial, or government identification numbers through general website contact forms.
              In the unlikely event of a security incident affecting personal information, we will
              notify affected individuals as required by applicable law, including the Pennsylvania
              Breach of Personal Information Notification Act.
            </p>
            <p class="text-earth-brown leading-relaxed-plus">
              We retain inquiry submissions, donation acknowledgment records, and website analytics
              only for as long as reasonably needed to serve families, operate our website, and meet
              nonprofit recordkeeping or legal obligations.
            </p>
          </section>

          <!-- Choices & Rights -->
          <section aria-labelledby="privacy-choices">
            <h2 id="privacy-choices" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              7. Your Privacy Choices, Opt-Outs &amp; Do Not Track
            </h2>
            <ul class="list-disc pl-6 space-y-2 text-earth-brown leading-relaxed-plus">
              <li>
                <strong>Access, Correction, or Deletion:</strong> You may email or call us at any time
                to request access to personal information you submitted through our website, ask us to
                correct inaccurate details, or request deletion (subject to nonprofit accounting or legal
                retention requirements).
              </li>
              <li>
                <strong>Email Opt-Out:</strong> To stop receiving non-essential school announcements or
                updates, email{' '}
                <a
                  href={`mailto:${email}?subject=Unsubscribe%20Request`}
                  class="font-semibold text-forest-canopy underline hover:text-moss-green"
                  >{email}</a
                >. We honor opt-out requests promptly (within 10 business days).
              </li>
              <li>
                <strong>Recurring Monthly Donations:</strong> You can cancel or update a recurring monthly
                gift at any time by emailing{' '}
                <a
                  href={`mailto:${email}?subject=Recurring%20Donation%20Update`}
                  class="font-semibold text-forest-canopy underline hover:text-moss-green"
                  >{email}</a
                > or calling{' '}
                <a
                  href={`tel:${phoneDigits}`}
                  class="font-semibold text-forest-canopy underline hover:text-moss-green"
                  >{phone}</a
                >. See{' '}
                <a
                  href="/policies#donations"
                  class="font-semibold text-forest-canopy underline hover:text-moss-green"
                  >Donations &amp; Giving Terms</a
                >.
              </li>
              <li>
                <strong>Cookies &amp; Analytics Controls:</strong> You can clear or block cookies and
                browser <code class="text-sm bg-stone-beige px-1.5 py-0.5 rounded"
                  >localStorage</code
                > together in your browser&apos;s site-data settings at any time. You can also opt out
                of Google Analytics using the{' '}
                <a
                  href="https://tools.google.com/dlpage/gaoptout"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-forest-canopy underline hover:text-moss-green inline-flex items-center gap-1"
                >
                  Google Analytics Opt-out Browser Add-on<ExternalLink
                    className="w-3.5 h-3.5"
                    aria-hidden="true"
                  /><span class="sr-only"> (opens in a new tab)</span>
                </a>.
              </li>
              <li>
                <strong>Do Not Track (DNT) &amp; Global Privacy Control (GPC):</strong> Because browsers
                transmit these signals inconsistently and we do not sell personal information or engage
                in cross-context behavioral advertising, our website does not currently alter its first-party
                analytics behavior in response to browser DNT or GPC signals. You can use the browser
                cookie/site-data controls and Google Analytics opt-out listed above.
              </li>
            </ul>
          </section>

          <!-- Changes & Contact -->
          <section aria-labelledby="privacy-contact" class="pt-6 border-t border-gray-200">
            <h2 id="privacy-contact" class="text-2xl lg:text-3xl font-bold text-earth-brown mb-4">
              8. Updates &amp; Contact Us
            </h2>
            <p class="text-earth-brown leading-relaxed-plus mb-6">
              We may update this Privacy Policy from time to time as our website or school practices
              evolve. Any changes will be posted on this page with an updated &ldquo;Last
              updated&rdquo; date. If you have questions about this policy or want to make a privacy
              request, please contact us:
            </p>
            <div class="rounded-xl bg-stone-beige p-6 border border-gray-200 space-y-4">
              <ContactInfo />
              <div class="flex flex-wrap gap-3 pt-2">
                <a
                  href={`mailto:${email}?subject=Privacy%20Inquiry`}
                  class="inline-flex items-center rounded-lg bg-forest-canopy px-4 py-2.5 text-sm font-semibold text-white hover:bg-moss-green transition-colors"
                >
                  <Mail className="w-4 h-4 mr-2" aria-hidden="true" />
                  Email Privacy Inquiry
                </a>
                <a
                  href={`tel:${phoneDigits}`}
                  class="inline-flex items-center rounded-lg border-2 border-forest-canopy px-4 py-2.5 text-sm font-semibold text-forest-canopy hover:bg-forest-canopy hover:text-white transition-colors"
                >
                  <Phone className="w-4 h-4 mr-2" aria-hidden="true" />
                  Call {phone}
                </a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
