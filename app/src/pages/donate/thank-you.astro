---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { db } from '@lib/db';
import { logServerError } from '@lib/server-logger';
import { CheckCircle, Heart, Mail } from 'lucide-astro';

const rawSessionId = Astro.url.searchParams.get('session_id')?.trim() ?? '';
const sessionId = /^cs_(test|live)_[A-Za-z0-9]+$/.test(rawSessionId) ? rawSessionId : null;

let schoolEmail = 'information@spicebushmontessori.org';
let schoolPhone = '(484) 202-0712';
let schoolEin: string | null = null;

try {
  const [dbEmail, dbPhone, dbEin] = await Promise.all([
    db.content.getSetting('school_email').catch(() => null),
    db.content.getSetting('school_phone').catch(() => null),
    db.content.getSetting('school_ein').catch(() => null)
  ]);
  if (typeof dbEmail === 'string' && dbEmail.trim().length > 0) {
    schoolEmail = dbEmail.trim();
  }
  if (typeof dbPhone === 'string' && dbPhone.trim().length > 0) {
    schoolPhone = dbPhone.trim();
  }
  if (typeof dbEin === 'string' && dbEin.trim().length > 0) {
    schoolEin = dbEin.trim();
  }
} catch (error) {
  logServerError('Failed to load contact settings on donation thank-you page', error, {
    route: '/donate/thank-you'
  });
}

const schoolPhoneDigits = schoolPhone.replace(/[^0-9]/g, '');
---

<Layout
  title="Thank You - Spicebush Montessori School"
  description="Thank you for supporting Spicebush Montessori School."
  keywords="Spicebush Montessori donation thank you"
  robots="noindex-follow"
>
  <Header />

  <main id="main-content" class="bg-stone-beige/20">
    <section class="py-16 lg:py-20">
      <div class="container mx-auto px-4">
        <div
          class="max-w-3xl mx-auto bg-white border border-gray-200 rounded-2xl shadow-sm p-8 lg:p-10 text-center"
        >
          <div class="flex justify-center mb-5">
            <div class="w-16 h-16 rounded-full bg-moss-green/15 flex items-center justify-center">
              <CheckCircle className="w-8 h-8 text-forest-canopy" aria-hidden="true" />
            </div>
          </div>

          <h1 class="text-3xl lg:text-4xl font-heading font-bold text-earth-brown mb-4">
            Thank You for Your Support
          </h1>

          <p class="text-lg text-earth-brown/85 leading-relaxed max-w-2xl mx-auto">
            Your gift helps keep Spicebush Montessori welcoming, inclusive, and accessible for
            families in our community. We are deeply grateful.
          </p>

          <div
            class="mt-8 rounded-xl border border-moss-green/20 bg-moss-green/10 px-5 py-4 text-left space-y-2"
          >
            <p class="font-semibold text-earth-brown">What happens next</p>
            <p class="text-sm text-earth-brown/85">
              You will receive an email confirmation for your gift. No goods or services were
              provided in exchange for this contribution{schoolEin ? ` (EIN: ${schoolEin})` : ''}.
              If you need an additional tax acknowledgment letter, have a question about a charge,
              or wish to cancel or update a recurring monthly gift at any time, email{' '}
              <a
                href={`mailto:${schoolEmail}?subject=Donation%20Support`}
                class="font-semibold text-forest-canopy underline hover:text-moss-green"
              >
                {schoolEmail}
              </a>{' '}
              or call{' '}
              <a
                href={`tel:${schoolPhoneDigits}`}
                class="font-semibold text-forest-canopy underline hover:text-moss-green"
              >
                {schoolPhone}
              </a>.
            </p>
            {
              sessionId && (
                <p class="pt-1 text-xs text-earth-brown/65 break-all">
                  Checkout reference: {sessionId}
                </p>
              )
            }
          </div>

          <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="/"
              class="inline-flex items-center justify-center rounded-lg bg-forest-canopy px-5 py-3 text-white font-semibold transition-colors hover:bg-moss-green"
            >
              <Heart className="w-4 h-4 mr-2" aria-hidden="true" />
              Return to Home
            </a>
            <a
              href={`mailto:${schoolEmail}`}
              class="inline-flex items-center justify-center rounded-lg border border-forest-canopy px-5 py-3 text-forest-canopy font-semibold transition-colors hover:bg-forest-canopy hover:text-white"
            >
              <Mail className="w-4 h-4 mr-2" aria-hidden="true" />
              Contact Our Team
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
