# NPM Configuration for Spicebush Montessori
# 
# Handle React 19 peer dependency conflicts gracefully
# This is a temporary solution until the ecosystem fully supports React 19
legacy-peer-deps=true

# prefer-offline was removed: with an unwritable or stale ~/.npm cache it made
# npm resolve against months-old registry metadata, so in-range updates
# reported newer versions as nonexistent (Oct 2026 maintenance, #148).
audit-level=moderate

# Security settings
fund=false