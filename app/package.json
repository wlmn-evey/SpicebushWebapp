{
  "name": "spicebush-montessori",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck:loose": "astro check --tsconfig tsconfig.production.json",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e:quick": "playwright test e2e/quick-smoke-test.spec.ts",
    "test:a11y": "playwright test e2e/accessibility-compliance-test.spec.ts",
    "test:performance": "playwright test e2e/performance-metrics.spec.ts",
    "validate:config": "node scripts/verify-deployment.cjs",
    "db:migrate": "bash scripts/apply-migrations.sh",
    "db:seed": "node scripts/insert-critical-data.js",
    "db:seed:netlify": "bash scripts/seed-netlify-db.sh",
    "db:check:migrations:netlify": "bash scripts/check-migrations-netlify.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:email": "node scripts/email-service-check.js",
    "setup:deployment": "node scripts/setup-deployment-automation.js",
    "predeploy:staging": "npm run db:check:migrations:netlify -- deploy-preview",
    "predeploy:production": "npm run db:check:migrations:netlify -- production",
    "deploy:staging": "npm run predeploy:staging && npm run build && bash scripts/netlify-deploy.sh",
    "deploy:production": "npm run predeploy:production && npm run build && bash scripts/netlify-deploy.sh --prod",
    "deploy:preview": "npm run build && bash scripts/netlify-deploy.sh --alias=preview",
    "test:db": "node verify-database-connection.cjs",
    "test:db:verify": "node verify-database-connection.cjs",
    "test:db:full": "node verify-database-connection.cjs",
    "test:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:all": "npm run test && npm run test:e2e",
    "test:ci": "npm run test:coverage && npm run test:e2e",
    "test:performance:full": "node scripts/run-performance-tests.js",
    "bundle:analyze": "node scripts/bundle-analysis.js",
    "images:audit": "node scripts/image-audit.js",
    "refine": "tsx scripts/refine-command.ts",
    "refine:dry-run": "tsx scripts/refine-command.ts --dry-run",
    "thinking-check": "tsx scripts/thinking-matrix-check.ts",
    "thinking-check:interactive": "tsx scripts/thinking-matrix-check.ts --interactive",
    "test:smoke": "playwright test e2e/critical/quick-smoke.spec.ts",
    "test:smoke:critical": "playwright test e2e/critical/quick-smoke.spec.ts --grep @critical",
    "test:comprehensive": "playwright test e2e/critical/comprehensive-smoke.spec.ts",
    "test:docker:health": "playwright test e2e/critical/docker-health-check.spec.ts",
    "test:browser:all": "playwright test e2e/critical/",
    "test:browser:report": "playwright show-report test-results/html-report",
    "test:browser": "tsx scripts/run-browser-tests.ts",
    "docker:dev": "docker-compose up --build",
    "docker:dev:bg": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up --build",
    "docker:logs": "docker-compose logs -f app",
    "setup:dev": "cp .env.example .env.local && echo 'Please update .env.local with your values'",
    "optimize:images": "node scripts/optimize-images.js",
    "favicons": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@astrojs/netlify": "^8.2.10",
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/html": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "astro": "^7.3.8",
    "csv-parse": "^7.0.3",
    "isomorphic-dompurify": "2.26.0",
    "jose": "^6.2.13",
    "lucide-astro": "^0.536.0",
    "marked": "^16.4.2",
    "nanoid": "^5.1.16",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^9.39.5",
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "^1.64.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.14.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^21.0.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "ipx": {
      "sharp": "$sharp"
    },
    "isomorphic-dompurify": {
      "dompurify": "^3.4.17"
    }
  }
}
